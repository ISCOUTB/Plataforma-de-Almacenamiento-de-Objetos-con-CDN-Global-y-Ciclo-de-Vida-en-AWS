# DOMUSNET - Variables de entorno para Terraform
# Copia este archivo como .env y rellena con tus valores reales.
# Nunca subas .env con tokens reales a GitHub.

# Token de API de Cloudflare con permiso DNS:Edit sobre domusnet.uk
# Obténlo en: My Profile → API Tokens → Create Token (DNS:Edit)
TF_VAR_cloudflare_api_token=TU_TOKEN_DE_CLOUDFLARE_AQUÍ

# Perfil de AWS CLI configurado en tu máquina, si no tienes uno creado, elimina o comenta esta línea
AWS_PROFILE=DomusnetCol

# Región de AWS para el despliegue
AWS_REGION=us-east-1
